# Copy to demo.env (git-ignored) next to run_overlay.sh on the board and fill in.
INSIGHT_HOST=SET-HOST-IP      # machine running Neat Insight (receives the encoded RTP video)
MEDIA_HOST=SET-HOST-IP        # RTSP server with the camera streams (used by recreate.sh)
MODELS_DIR=/data/models       # extra model packs, mounted at /opt/neat-app/models2
IMAGE=neat-overlay:mounted
